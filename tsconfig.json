{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "paths": {
      "@bastion/core": [
        "./packages/core/src/index.ts"
      ],
      "@bastion/express": [
        "./packages/express/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.json",
    "packages/*/test/**/*.ts",
    "scripts/**/*.ts",
    "vitest.config.ts",
    "apps/playground/test/**/*.ts",
    "examples/**/*.ts"
  ]
}
