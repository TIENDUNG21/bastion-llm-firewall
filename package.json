{
  "name": "bastion-llm-firewall",
  "version": "0.1.0",
  "private": true,
  "description": "A firewall for LLM apps. Stops prompt injection and data leaks.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/express",
    "packages/cli",
    "apps/playground"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/playground/tsconfig.json",
    "test": "vitest run",
    "build": "npm run build -w @bastion/core && npm run build -w @bastion/express && npm run build -w @bastion/cli && npm run build -w @bastion/playground",
    "fetch-data": "tsx scripts/fetch-datasets.ts",
    "train": "tsx scripts/train.ts",
    "evaluate": "tsx scripts/evaluate.ts",
    "bastion": "node packages/cli/dist/bin.js",
    "check:pages": "node scripts/check-pages-build.mjs",
    "dev": "npm run dev -w @bastion/playground"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.15.0",
    "express": "^5.3.0",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
